{
  "name": "wrkflw",
  "displayName": "WRKFLW - GitHub Actions Workflow Validator",
  "description": "Validate GitHub Actions workflows with real-time diagnostics, completion, and hover information",
  "version": "0.7.3",
  "publisher": "wrkflw",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "github",
    "actions",
    "workflow",
    "yaml",
    "ci/cd",
    "validator"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "workspaceContains:.github/workflows/*.yml",
    "workspaceContains:.github/workflows/*.yaml"
  ],
  "main": "./out/extension.js",
  "browser": "./out/extension-web.js",
  "dependencies": {
    "vscode-languageclient": "^9.0.0",
    "vscode-languageserver": "^9.0.0",
    "vscode-languageserver-protocol": "^3.17.0",
    "vscode-languageserver-textdocument": "^1.0.0",
    "yaml": "^2.3.0"
  },
  "contributes": {
    "languages": [{
      "id": "github-actions",
      "aliases": ["GitHub Actions", "workflow"],
      "extensions": [".yml", ".yaml"],
      "filenamePatterns": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml"
      ],
      "configuration": "./language-configuration.json"
    }],
    "commands": [
      {
        "command": "wrkflw.validateWorkflow",
        "title": "Validate Current Workflow",
        "category": "WRKFLW"
      }
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/node": "^20",
    "@types/vscode": "^1.80",
    "esbuild": "^0.19",
    "typescript": "^5",
    "vitest": "^1.0.0"
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:server",
    "build:extension": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "build:extension:web": "esbuild src/extension-web.ts --bundle --outfile=out/extension-web.js --external:vscode --format=cjs --platform=browser",
    "build:server": "tsc -p tsconfig.server.json",
    "watch": "npm run build:extension -- --watch",
    "watch:server": "tsc -p tsconfig.server.json --watch",
    "test": "vitest",
    "lint": "biome check src server/src",
    "lint:fix": "biome check --write src server/src",
    "format": "biome format --write src server/src"
  }
}
